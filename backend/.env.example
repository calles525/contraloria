# Configuracion del servidor
PORT=3030
HOST=0.0.0.0
NODE_ENV=development

# Base de datos (Laragon: localhost, root sin clave)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=contraloria

# Seguridad
JWT_SECRET=cambiar_esta_clave_secreta_muy_larga_segura
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Cors — origenes permitidos (separados por coma).
# Solo estos pueden consumir la API desde un navegador.
#  - Origen exacto:        https://app.dominio.com
#  - Comodin de subdominio: https://*.dominio.com (acepta cualquier subdominio,
#    practico en produccion para deploy previews)
#  - Comodin total:        * (acepta CUALQUIER origen, no recomendado en produccion)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------
# PRODUCCION
# Copia este archivo como .env.production en el servidor y ajusta:
#   NODE_ENV=production
#   PORT=3030
#   DB_HOST=host_de_produccion
#   DB_USER=usuario_de_produccion
#   DB_PASSWORD=clave_de_produccion
#   DB_NAME=contraloria
#   JWT_SECRET=clave_secreta_larga_y_aleatoria
#   CORS_ORIGIN=https://dominio-del-frontend.com,https://*.dominio-del-frontend.com
#
# El backend carga .env.production automaticamente cuando NODE_ENV=production
# (ver backend/src/config/env.js). Un archivo .env de respaldo tambien se lee,
# pero las variables del entorno real del proceso tienen prioridad.
# ---------------------------------------------------------------