# Configuracion del servidor
PORT=3030
HOST=0.0.0.0
NODE_ENV=development

# Base de datos (Laragon: localhost, root sin clave)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=contraloria

# Seguridad
JWT_SECRET=cambiar_esta_clave_secreta_muy_larga_segura
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# CORS
# "*" = cualquiera puede conectarse a la API (lo que usa el sistema ahora).
# Si se deja vacio, tambien se comporta como comodin total.
# Ademas admite una lista de origenes separados por coma, y comodines de
# subdominio, por ejemplo:
#   CORS_ORIGIN=https://app.dominio.com,https://*.netlify.app
CORS_ORIGIN=*

# ---------------------------------------------------------------
# PRODUCCION
# Copia este archivo como .env.production en el servidor y ajusta:
#   NODE_ENV=production
#   PORT=3030
#   DB_HOST=host_de_produccion
#   DB_USER=usuario_de_produccion
#   DB_PASSWORD=clave_de_produccion
#   DB_NAME=contraloria
#   JWT_SECRET=clave_secreta_larga_y_aleatoria
#   CORS_ORIGIN=*
#
# El backend carga .env.production automaticamente cuando NODE_ENV=production
# (ver backend/src/config/env.js). Un archivo .env de respaldo tambien se lee,
# pero las variables del entorno real del proceso tienen prioridad.
# ---------------------------------------------------------------